# Copy to .env and edit. All values are optional.

# Bind address / port for the server.
NEEDLE_HOST=0.0.0.0
NEEDLE_PORT=8000

# Require `Authorization: Bearer <key>`. Unset = open server.
# NEEDLE_API_KEY=sk-local-needle

# Model id advertised by GET /v1/models.
NEEDLE_MODEL_ID=needle-2

# 404 requests naming any other model. Off by default so clients that hard-code
# e.g. "gpt-4o-mini" keep working.
NEEDLE_STRICT_MODEL=false

# Serve a tuned .cact instead of the base model (see `needle build`).
# NEEDLE_WEIGHTS=/weights/needle_tuned.cact

# Default generation cap when a request omits max_tokens.
NEEDLE_MAX_NEW_TOKENS=256

# Requests serialize through one engine thread; reject past this backlog.
NEEDLE_MAX_QUEUE_DEPTH=32
NEEDLE_REQUEST_TIMEOUT=120

# Cap on engine calls used to replay one conversation's history.
NEEDLE_MAX_REPLAY_STEPS=32

# Include the x_needle block (confidence, reasoning, timings) on responses.
NEEDLE_EXPOSE_EXTRAS=true

# Use the model's sentencepiece tokenizer for exact `usage` counts when
# available; falls back to a character heuristic.
NEEDLE_EXACT_TOKEN_COUNTS=true

# CORS. Comma-separated, or * for any origin.
NEEDLE_ALLOWED_ORIGINS=*

# Avoids anonymous HuggingFace rate limits on the first download.
# HF_TOKEN=hf_...
